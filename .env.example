# Core input: json consumes an existing ChatLab JSON file without accessing QQ.
# Optional input integration: export asks the external exporter for one file.
CSBAOYAN_SOURCE=json
CSBAOYAN_TIMEZONE=Asia/Shanghai
CSBAOYAN_REPORT_DIR=internal/reports
CSBAOYAN_EXPORT_DIR=chat_exports

# Optional QQ integration. This project does not read the QQ database itself.
QQNT_EXPORT_COMMAND=/absolute/path/to/qqnt-export-macos/.venv/bin/qqnt-export-macos
QQNT_KEY_PATH=/absolute/path/to/database.key
QQNT_CACHE_DIR=/absolute/path/to/private/qqnt-cache
QQNT_CONVERSATION_ID=group:your_group_id
# Optional when more than one QQ account is present:
# QQNT_ACCOUNT=nt_qq_your_account_directory
# QQNT_DATA_ROOT=/absolute/path/to/QQ/data/root

# OpenAI-compatible provider
OPENAI_BASE_URL=https://your-provider.example/v1
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=your_model_id
# Optional: use a stronger model only for the cross-chunk editor pass.
# OPENAI_FINAL_MODEL=your_stronger_model_id
# Optional: ordered OpenRouter provider allowlist. The first provider is preferred;
# failures only fall back within this list. Leave empty for OpenRouter automatic routing.
OPENROUTER_PROVIDER_ORDER=

# Optional Cloudflare R2 publishing
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=your_bucket_name
R2_PUBLIC_BASE_URL=https://data.example.com

# Optional Telegram broadcast and public verification origin
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHANNEL_ID=@your_channel_username
SITE_BASE_URL=https://reports.example.com
