# Message source: qqnt (default) or json (legacy backfill)
CSBAOYAN_SOURCE=qqnt
CSBAOYAN_TIMEZONE=Asia/Shanghai
CSBAOYAN_REPORT_DIR=internal/reports
CSBAOYAN_EXPORT_DIR=chat_exports

# qqnt-export-macos read-only live bridge
QQNT_EXPORT_COMMAND=/absolute/path/to/qqnt-export-macos/.venv/bin/qqnt-export-macos
QQNT_KEY_PATH=/absolute/path/to/database.key
QQNT_CACHE_DIR=/absolute/path/to/private/qqnt-cache
QQNT_CONVERSATION_ID=group:your_group_id
# Optional when more than one QQ account is present:
# QQNT_ACCOUNT=nt_qq_your_account_directory
# QQNT_DATA_ROOT=/absolute/path/to/QQ/data/root

# OpenAI-compatible provider
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=your_openrouter_api_key_here
OPENAI_MODEL=your_openrouter_model_id

# Cloudflare R2 S3 credentials, scoped to csbaoyan-chat-daily
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=csbaoyan-chat-daily
R2_PUBLIC_BASE_URL=https://data.csbaoyan.icelon.top

# Optional Telegram broadcast
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHANNEL_ID=@your_channel_username
SITE_BASE_URL=https://csbaoyan.icelon.top
