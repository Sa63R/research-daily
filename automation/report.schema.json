{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "title",
    "summary",
    "highlights",
    "timeline",
    "uncertain"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [
        2
      ]
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "highlights": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "title",
          "text",
          "kind",
          "confidence",
          "basis",
          "evidenceIds",
          "links"
        ],
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "院校与项目",
              "申请与考核",
              "经验与选择",
              "科研与学习"
            ]
          },
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "动态",
              "经验",
              "分析",
              "资源"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium"
            ]
          },
          "basis": {
            "type": "string"
          },
          "evidenceIds": {
            "$ref": "#/$defs/evidence"
          },
          "links": {
            "$ref": "#/$defs/links"
          }
        }
      },
      "maxItems": 12
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "startTime",
          "endTime",
          "title",
          "text",
          "keyPoints",
          "status",
          "evidenceIds",
          "links"
        ],
        "properties": {
          "startTime": {
            "type": "string",
            "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
          },
          "endTime": {
            "type": "string",
            "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
          },
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "keyPoints": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "maxItems": 4
          },
          "status": {
            "type": "string",
            "enum": [
              "已有答复",
              "形成共识",
              "仍有分歧",
              "没有结论"
            ]
          },
          "evidenceIds": {
            "$ref": "#/$defs/evidence"
          },
          "links": {
            "$ref": "#/$defs/links"
          }
        }
      },
      "maxItems": 24
    },
    "uncertain": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "claim",
          "whyUncertain",
          "verification",
          "evidenceIds",
          "links"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "whyUncertain": {
            "type": "string"
          },
          "verification": {
            "type": "string"
          },
          "evidenceIds": {
            "$ref": "#/$defs/evidence"
          },
          "links": {
            "$ref": "#/$defs/links"
          }
        }
      },
      "maxItems": 8
    }
  },
  "$defs": {
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "url"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    }
  }
}
